        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Cargar el archivo de clientes\n",
        "df_clientes = pd.read_csv('clientes.csv')\n",
        "\n",
        "print(\"=== INFORMACIÓN INICIAL DE CLIENTES ===\")\n",
        "print(f\"Dimensiones de df_clientes: {df_clientes.shape}\")\n",
        "print(df_clientes.dtypes)\n",
        "display(df_clientes.head())\n",
        "\n",
        "# 2. Integrar clientes con el DataFrame maestro de ventas (df_final)\n",
        "# Conectamos usando la columna en común 'cliente_id'\n",
        "df_maestro_clientes = pd.merge(df_final, df_clientes, on='cliente_id', how='left')\n",
        "\n",
        "# Crear columna de ingreso neto por transacción de cliente (0 si fue devuelto)\n",
        "df_maestro_clientes['ingreso_neto_cliente'] = np.where(\n",
        "    df_maestro_clientes['fue_devuelto'] == True,\n",
        "    0.0,\n",
        "    df_maestro_clientes['total_linea']\n",
        ")\n",
        "\n",
        "# 3. Análisis por Segmento de Cliente (si existe columna de segmento o similar, o por género/edad)\n",
        "print(\"\\n=== RENDIMIENTO DE VENTAS Y DEVOLUCIONES POR GÉNERO / SEGMENTO ===\")\n",
        "columnas_disponibles = df_clientes.columns.tolist()\n",
        "\n",
        "# Identificar dinámicamente si hay columnas clave como 'genero', 'edad', 'segmento' o 'provincia'\n",
        "grupos = []\n",
        "if 'genero' in columnas_disponibles:\n",
        "    grupos.append('genero')\n",
        "elif 'género' in columnas_disponibles:\n",
        "    grupos.append('género')\n",
        "if 'segmento' in columnas_disponibles:\n",
        "    grupos.append('segmento')\n",
        "\n",
        "if grupos:\n",
        "    analisis_segmento = (\n",
        "        df_maestro_clientes\n",
        "        .groupby(grupos)\n",
        "        .agg(\n",
        "            frecuencia_compras=('pedido_id', 'nunique'),\n",
        "            gasto_bruto_total=('total_linea', 'sum'),\n",
        "            gasto_neto_total=('ingreso_neto_cliente', 'sum'),\n",
        "            tasa_devolucion_pct=('fue_devuelto', lambda x: x.mean() * 100)\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "    display(analisis_segmento)\n",
        "else:\n",
        "    print(\"Columnas de segmento específicas no detectadas en el CSV. Realizaremos un análisis de valor por Cliente (LTV).\")\n",
        "\n",
        "# 4. Análisis del Valor de Vida del Cliente (LTV preliminar en el histórico)\n",
        "print(\"\\n=== TOP 10 CLIENTES CON MAYOR VALOR NETO DE COMPRA (LTV HISTÓRICO) ===\")\n",
        "ltv_clientes = (\n",
        "    df_maestro_clientes\n",
        "    .groupby(['cliente_id', 'nombre_y'] if 'nombre_y' in df_maestro_clientes.columns else ['cliente_id'])\n",
        "    .agg(\n",
        "        pedidos_totales=('pedido_id', 'nunique'),\n",
        "        total_invertido_bruto=('total_linea', 'sum'),\n",
        "        total_neto_real=('ingreso_neto_cliente', 'sum'),\n",
        "        tasa_devolucion_cliente_pct=('fue_devuelto', lambda x: x.mean() * 100)\n",
        "    )\n",
        "    .sort_values(by='total_neto_real', ascending=False)\n",
        "    .head(10)\n",
        "    .reset_index()\n",
        ")\n",
        "display(ltv_clientes)"
