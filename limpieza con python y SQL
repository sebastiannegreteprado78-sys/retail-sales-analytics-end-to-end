      "source": [
        "# 3. ANÁLISIS DE CANALES Y EXPORTACIÓN DEL REPORTE\n",
        "df_final['importe_devuelto'] = np.where(df_final['fue_devuelto'], df_final['total_linea'], 0.0)\n",
        "df_resumen_canales = df_final.groupby('canal').agg(\n",
        "    ventas_brutas=('total_linea', 'sum'),\n",
        "    total_devoluciones_eur=('importe_devuelto', 'sum'),\n",
        "    tasa_devolucion_pct=('fue_devuelto', lambda x: x.mean() * 100)\n",
        ").reset_index()\n",
        "\n",
        "df_resumen_canales['ingreso_neto_real'] = df_resumen_canales['ventas_brutas'] - df_resumen_canales['total_devoluciones_eur']\n",
        "\n",
        "# Guardar reporte limpio\n",
        "df_resumen_canales.to_csv('reporte_canales_2024.csv', index=False)\n",
        "display(df_resumen_canales)"
      ],
