        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Cargar el archivo de clientes\n",
        "df_clientes = pd.read_csv('clientes.csv')\n",
        "\n",
        "# 2. Estandarizar la columna 'genero' para evitar duplicados ('F', 'f', 'Femenino' -> 'Femenino')\n",
        "mapeo_genero = {\n",
        "    'F': 'Femenino',\n",
        "    'f': 'Femenino',\n",
        "    'Femenino': 'Femenino',\n",
        "    'M': 'Masculino',\n",
        "    'm': 'Masculino',\n",
        "    'Masculino': 'Masculino'\n",
        "}\n",
        "df_clientes['genero_limpio'] = df_clientes['genero'].map(mapeo_genero)\n",
        "\n",
        "# 3. Integrar los clientes con el DataFrame maestro de ventas (df_final)\n",
        "df_maestro_clientes = pd.merge(df_final, df_clientes, on='cliente_id', how='left')\n",
        "\n",
        "# Crear columna de ingreso neto por transacción (0 si fue devuelto)\n",
        "df_maestro_clientes['ingreso_neto_cliente'] = np.where(\n",
        "    df_maestro_clientes['fue_devuelto'] == True,\n",
        "    0.0,\n",
        "    df_maestro_clientes['total_linea']\n",
        ")\n",
        "\n",
        "# 4. Rendimiento de Ventas por Género Limpio\n",
        "print(\"=== RENDIMIENTO DE VENTAS POR GÉNERO (LIMPIO) ===\")\n",
        "analisis_genero_limpio = (\n",
        "    df_maestro_clientes\n",
        "    .groupby('genero_limpio')\n",
        "    .agg(\n",
        "        frecuencia_compras=('pedido_id', 'nunique'),\n",
        "        gasto_bruto_total=('total_linea', 'sum'),\n",
        "        gasto_neto_total=('ingreso_neto_cliente', 'sum'),\n",
        "        tasa_devolucion_pct=('fue_devuelto', lambda x: x.mean() * 100)\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "display(analisis_genero_limpio)\n",
        "\n",
        "# 5. Análisis de Comportamiento por Ciudad (Top 10)\n",
        "print(\"\\n=== COMPORTAMIENTO DE COMPRA POR CIUDAD (TOP 10) ===\")\n",
        "df_maestro_clientes['ciudad_cliente_limpia'] = df_maestro_clientes['ciudad_y'].str.strip().str.capitalize()\n",
        "\n",
        "analisis_ciudad = (\n",
        "    df_maestro_clientes\n",
        "    .groupby('ciudad_cliente_limpia')\n",
        "    .agg(\n",
        "        total_compradores=('cliente_id', 'nunique'),\n",
        "        compras_totales=('pedido_id', 'nunique'),\n",
        "        ventas_brutas=('total_linea', 'sum'),\n",
        "        ingreso_neto_real=('ingreso_neto_cliente', 'sum'),\n",
        "        tasa_devolucion_pct=('fue_devuelto', lambda x: x.mean() * 100)\n",
        "    )\n",
        "    .sort_values(by='ingreso_neto_real', ascending=False)\n",
        "    .head(10)\n",
        "    .reset_index()\n",
        ")\n",
        "display(analisis_ciudad)"
