        },
        "id": "9f725f87",
        "outputId": "0d3b97f4-80ab-4a1d-f508-75976787a709"
      },
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import sqlite3\n",
        "\n",
        "# 1. CARGA DE DATOS\n",
        "try:\n",
        "    df_pedidos = pd.read_csv('pedidos.csv')\n",
        "    df_productos = pd.read_csv('productos.csv')\n",
        "    df_campanas = pd.read_csv('campana.csv')\n",
        "    df_lineas = pd.read_csv('lineas_pedido.csv')\n",
        "    df_devoluciones = pd.read_csv('devoluciones.csv')\n",
        "    df_clientes = pd.read_csv('clientes.csv')\n",
        "    print(\"¡Todos los archivos cargados exitosamente!\")\n",
        "except FileNotFoundError as e:\n",
        "    print(f\"Error: {e}. Asegúrate de que los archivos estén en tu entorno de Colab.\")"
      ],
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
