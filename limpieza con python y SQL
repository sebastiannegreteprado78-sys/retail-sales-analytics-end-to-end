        "import numpy as np\n",
        "\n",
        "# 1. Limpiar la columna 'presupuesto'\n",
        "def limpiar_presupuesto(val):\n",
        "    if pd.isna(val):\n",
        "        return np.nan\n",
        "    val_str = str(val).strip()\n",
        "    # Si contiene el símbolo '€', asumimos formato europeo (ej: '61.000 €') donde el '.' es separador de miles\n",
        "    if '€' in val_str:\n",
        "        val_str = val_str.replace('€', '').replace(' ', '')\n",
        "        val_str = val_str.replace('.', '')\n",
        "    return float(val_str)\n",
        "\n",
        "df_campanas['presupuesto_limpio'] = df_campanas['presupuesto'].apply(limpiar_presupuesto)\n",
        "\n",
        "print(\"--- Campañas con Presupuesto Limpio ---\")\n",
        "display(df_campanas[['campana_id', 'nombre', 'presupuesto', 'presupuesto_limpio']])"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "2fb0dcee"
      },
      "source": [
        "# 2. Unir las ventas detalladas (df_final) con la información de campañas\n",
        "# Primero filtramos para obtener solo los registros asociados a una campaña activa (campana_id no nulo)\n",
        "df_ventas_campanas = df_final[df_final['campana_id'].notna()].copy()\n",
        "\n",
        "# Renombramos 'nombre' a 'nombre_campana' en df_campanas antes de unir para evitar colisiones con el nombre del producto\n",
        "df_campanas_temp = df_campanas[['campana_id', 'nombre', 'presupuesto_limpio']].rename(columns={'nombre': 'nombre_campana'})\n",
        "\n",
        "# Unimos con df_ventas_campanas\n",
        "df_ventas_campanas = pd.merge(\n",
        "    df_ventas_campanas,\n",
        "    df_campanas_temp,\n",
        "    on='campana_id',\n",
        "    how='left'\n",
        ")\n",
        "\n",
        "# 3. Calcular los ingresos netos reales por campaña (restando devoluciones)\n",
        "# Creamos una columna para el ingreso real neto de cada línea de pedido\n",
        "df_ventas_campanas['ingreso_neto_linea'] = np.where(\n",
        "    df_ventas_campanas['fue_devuelto'] == True,\n",
        "    0.0,\n",
        "    df_ventas_campanas['total_linea']\n",
        ")\n",
        "\n",
        "# 4. Agrupar por campaña para consolidar métricas\n",
        "resumen_campanas = (\n",
        "    df_ventas_campanas\n",
        "    .groupby(['campana_id', 'nombre_campana', 'presupuesto_limpio'])\n",
        "    .agg(\n",
        "        ingreso_bruto=('total_linea', 'sum'),\n",
        "        ingreso_neto=('ingreso_neto_linea', 'sum')\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# 5. Calcular el Retorno de la Inversión (ROI) y el margen neto generado\n",
        "resumen_campanas['beneficio_neto'] = resumen_campanas['ingreso_neto'] - resumen_campanas['presupuesto_limpio']\n",
        "resumen_campanas['ROI_pct'] = (resumen_campanas['beneficio_neto'] / resumen_campanas['presupuesto_limpio']) * 100\n",
