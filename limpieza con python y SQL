      "source": [
        "# 1. Obtener los totales agregados para la campaña 1.0\n",
        "ingreso_bruto_campana = df_ventas_campanas['total_linea'].sum()\n",
        "ingreso_neto_campana = df_ventas_campanas['ingreso_neto_linea'].sum()\n",
        "presupuesto_campana = df_campanas.loc[df_campanas['campana_id'] == 1, 'presupuesto_limpio'].values[0]\n",
        "\n",
        "# 2. Aplicar las fórmulas solicitadas de manera explícita\n",
        "beneficio_neto_campana = ingreso_neto_campana - presupuesto_campana\n",
        "roi_campana = (beneficio_neto_campana / presupuesto_campana) * 100\n",
        "\n",
        "# 3. Presentar los resultados con claridad\n",
        "print(\"=== ANÁLISIS CONFIRMADO DE LA CAMPAÑA REBAJAS VERANO 2024 ===\")\n",
