      "source": [
        "# 1. Unir df_con_devoluciones con df_pedidos usando 'pedido_id'\n",
        "df_final = pd.merge(df_con_devoluciones, df_pedidos, on='pedido_id', how='left')\n",
        "\n",
        "# 2. Agrupar por 'canal' y realizar los cálculos solicitados\n",
        "analisis_canal = (\n",
        "    df_final\n",
        "    .groupby('canal')\n",
        "    .agg(\n",
        "        total_facturado=('total_linea', 'sum'),\n",
        "        tasa_devolucion=('fue_devuelto', lambda x: x.mean() * 100)\n",
        "    )\n",
        "    .sort_values(by='total_facturado', ascending=False)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# 3. Mostrar el resultado de forma clara\n",
        "print(\"--- Análisis por Canal Publicitario ---\")\n",
        "display(analisis_canal)"
