      "source": [
        "# Aseguramos que cargamos las líneas de pedido limpias en 'df'\n",
        "df = pd.read_csv('lineas_pedido.csv')\n",
        "\n",
        "# Limpieza básica de la tabla de pedidos\n",
        "df['precio_unitario'] = df['precio_unitario'].str.replace('€', '', regex=False).str.replace(',', '.', regex=False).astype(float)\n",
        "df['sub_total_sin_descuento'] = df['cantidad'] * df['precio_unitario']\n",
        "df['descuento_pct'] = pd.to_numeric(\n",
        "    df['descuento_pct'].astype(str).str.replace(',', '.', regex=False).str.replace(r'[^\\d.]', '', regex=True),\n",
        "    errors='coerce'\n",
        ")\n",
        "df.loc[df['descuento_pct'] >= 1, 'descuento_pct'] = df['descuento_pct'] / 100\n",
        "df['total_linea'] = df['sub_total_sin_descuento'] * (1 - df['descuento_pct'])\n",
        "\n",
        "# Unir líneas de pedido con productos usando 'producto_id'\n",
        "df_completo = pd.merge(df, df_productos, on='producto_id')\n",
        "\n",
        "# 1. Top 5 productos con mayor facturación\n",
        "top_5_productos = (\n",
        "    df_completo\n",
        "    .groupby(['producto_id', 'nombre'])['total_linea']\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        "    .head(5)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(\"--- Top 5 Productos ---\")\n",
        "display(top_5_productos)\n",
        "\n",
        "# 2. Ranking de ventas por categoría limpia\n",
        "df_ranking = (\n",
        "    df_completo\n",
        "    .groupby('categoria_limpia')['total_linea']\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(\"\\n--- Ranking de Categorías ---\")\n",
        "display(df_ranking)"
      ],
