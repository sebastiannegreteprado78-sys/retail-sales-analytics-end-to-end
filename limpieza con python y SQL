      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "# 1. Cargar el archivo\n",
        "df = pd.read_csv('lineas_pedido.csv')\n",
        "\n",
        "# 2. Limpiar y convertir precio_unitario a float\n",
        "df['precio_unitario'] = df['precio_unitario'].str.replace('€', '', regex=False)\n",
        "df['precio_unitario'] = df['precio_unitario'].str.replace(',', '.', regex=False)\n",
        "df['precio_unitario'] = df['precio_unitario'].astype(float)\n",
        "\n",
        "# 3. Calcular subtotal sin descuento\n",
        "df['sub_total_sin_descuento'] = df['cantidad'] * df['precio_unitario']\n",
        "\n",
        "# 4. Limpiar y estandarizar descuento_pct a escala 0.0 - 1.0\n",
        "df['descuento_pct'] = pd.to_numeric(\n",
        "    df['descuento_pct'].astype(str).str.replace(',', '.', regex=False).str.replace(r'[^\\d.]', '', regex=True),\n",
