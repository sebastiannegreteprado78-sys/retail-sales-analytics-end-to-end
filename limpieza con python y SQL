        "id": "0310bad3",
        "outputId": "593424ff-95f2-410c-cbc8-9ec67d3d879e"
      },
      "source": [
        "# 2. PIPELINE DE LIMPIEZA Y PROCESAMIENTO\n",
        "\n",
        "# Limpieza de categorías de productos\n",
        "reemplazos = {\n",
        "    'vestido': 'vestidos', 'camiseta': 'camisetas', 'pantalon': 'pantalones',\n",
        "    'falda': 'faldas', 'abrigo': 'abrigos', 'zapatos': 'calzado',\n",
        "    'accesorio': 'accesorios', 'complementos': 'accesorios',\n",
        "    'jersey': 'jerseis', 'jerséis': 'jerseis'\n",
        "}\n",
        "df_productos['categoria_limpia'] = df_productos['categoria'].str.strip().str.lower().replace(reemplazos)\n",
        "\n",
        "# Limpieza de precios y cálculo de totales en líneas de pedido\n",
        "df_lineas['precio_unitario'] = df_lineas['precio_unitario'].astype(str).str.replace('€', '', regex=False).str.replace(',', '.', regex=False).astype(float)\n",
        "df_lineas['sub_total_sin_descuento'] = df_lineas['cantidad'] * df_lineas['precio_unitario']\n",
        "df_lineas['descuento_pct'] = pd.to_numeric(\n",
        "    df_lineas['descuento_pct'].astype(str).str.replace(',', '.', regex=False).str.replace(r'[^\\d.]', '', regex=True),\n",
        "    errors='coerce'\n",
        ")\n",
        "df_lineas.loc[df_lineas['descuento_pct'] >= 1, 'descuento_pct'] = df_lineas['descuento_pct'] / 100\n",
        "df_lineas['total_linea'] = df_lineas['sub_total_sin_descuento'] * (1 - df_lineas['descuento_pct'])\n",
        "\n",
        "# Uniones de tablas y marca de devoluciones\n",
        "df_completo = pd.merge(df_lineas, df_productos, on='producto_id', how='inner')\n",
        "df_con_devoluciones = pd.merge(df_completo, df_devoluciones, on='linea_id', how='left')\n",
        "df_con_devoluciones['fue_devuelto'] = df_con_devoluciones['devolucion_id'].notna()\n",
        "\n",
        "# Combinar con pedidos y estandarizar fechas\n",
        "df_pedidos['fecha_pedido'] = pd.to_datetime(df_pedidos['fecha_pedido'], dayfirst=True, format='mixed')\n",
        "df_final = pd.merge(df_con_devoluciones, df_pedidos, on='pedido_id', how='left')\n",
        "\n",
        "print(\"Pipeline de uniones y transformaciones completado con éxito.\")"
      ],
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Pipeline de uniones y transformaciones completado con éxito.\n"
          ]
        }
      ]
    },
